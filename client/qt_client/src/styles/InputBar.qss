/* InputBar：工具栏、无边框文本编辑区和品牌渐变发送按钮。 */
QWidget#inputBar {
    background-color: rgba(255, 255, 255, 0.82);
    border-top: 1px solid rgba(109, 88, 172, 0.12);
}

QWidget#inputToolbar {
    background: transparent;
}

QToolButton#emojiToolButton,
QToolButton#imageToolButton,
QToolButton#fileToolButton,
QToolButton#screenshotToolButton {
    color: #77708F;
    background: transparent;
    border: none;
    border-radius: 9px;
    font-size: 17px;
}
QToolButton#emojiToolButton:hover,
QToolButton#imageToolButton:hover,
QToolButton#fileToolButton:hover,
QToolButton#screenshotToolButton:hover {
    color: #6A53F6;
    background-color: rgba(106, 83, 246, 0.09);
}

QLabel#inputShortcutHint {
    color: #A39BB9;
    font-size: 9px;
}

QTextEdit#messageEditor {
    color: #302A48;
    background: transparent;
    border: none;
    padding: 3px 1px;
    selection-background-color: #ECE6FF;
    selection-color: #302A48;
    font-size: 12px;
}
QTextEdit#messageEditor:focus {
    border: none;
    outline: none;
}

QPushButton#sendButton {
    color: #FFFFFF;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #806BFF, stop:0.52 #6A53F6, stop:1 #927BFF);
    border: none;
    border-radius: 13px;
    padding: 0 15px;
    font-size: 11px;
    font-weight: 75;
}
QPushButton#sendButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #927FFF, stop:0.52 #5941E7, stop:1 #806BFF);
}
QPushButton#sendButton:pressed {
    background: #5941E7;
    padding-top: 1px;
}
QPushButton#sendButton:disabled {
    color: rgba(255, 255, 255, 0.75);
    background: #B8ADEE;
}
