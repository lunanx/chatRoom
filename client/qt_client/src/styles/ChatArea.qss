/* ChatArea：对应聊天面板、会话 Header 和消息列表。顶层窗口控制由 MainWindow 统一绘制。 */
QWidget#chatArea {
    background-color: #F5F2FB;
    color: #302A48;
    border: none;
}

QWidget#chatHeader {
    background-color: rgba(255, 255, 255, 0.78);
    border-bottom: 1px solid rgba(88, 70, 130, 0.08);
}

QLabel#chatHeaderAvatar {
    color: #FFFFFF;
    font-size: 13px;
    font-weight: 800;
    border: 1px solid rgba(255, 255, 255, 0.9);
    border-radius: 16px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #A39BEF, stop:1 #5550A6);
}

QLabel#chatHeaderName {
    color: #302A48;
    font-size: 12px;
    font-weight: 800;
}

QLabel#onlineStatusText {
    color: #77708F;
    font-size: 9px;
}

QLabel#onlineStatusDot {
    border: none;
    border-radius: 3px;
    background-color: #A39BB9;
}
QLabel#onlineStatusDot[online="true"] {
    background-color: #50B994;
}

QWidget#networkStatusBadge {
    background-color: rgba(255, 255, 255, 0.58);
    border: 1px solid rgba(108, 91, 154, 0.08);
    border-radius: 12px;
}
QWidget#networkStatusBadge[networkState="connected"] {
    background-color: rgba(80, 185, 148, 0.08);
    border-color: rgba(80, 185, 148, 0.16);
}
QWidget#networkStatusBadge[networkState="connecting"] {
    background-color: rgba(128, 107, 255, 0.08);
    border-color: rgba(128, 107, 255, 0.15);
}
QWidget#networkStatusBadge[networkState="disconnected"],
QWidget#networkStatusBadge[networkState="error"] {
    background-color: rgba(190, 105, 133, 0.08);
    border-color: rgba(190, 105, 133, 0.16);
}
QLabel#networkStatusDot {
    border: none;
    border-radius: 3px;
    background-color: #A39BB9;
}
QLabel#networkStatusDot[networkState="connected"] { background-color: #50B994; }
QLabel#networkStatusDot[networkState="connecting"] { background-color: #8D7BEE; }
QLabel#networkStatusDot[networkState="disconnected"],
QLabel#networkStatusDot[networkState="error"] { background-color: #BE6985; }
QLabel#networkStatusText {
    color: #77708F;
    font-size: 9px;
}
QLabel#networkStatusText[networkState="connected"] { color: #398B73; }
QLabel#networkStatusText[networkState="connecting"] { color: #7763D0; }
QLabel#networkStatusText[networkState="disconnected"],
QLabel#networkStatusText[networkState="error"] { color: #B15F7B; }

QListView#messageListView {
    background: transparent;
    border: none;
    outline: none;
    padding: 12px 18px;
    color: #302A48;
}
QListView#messageListView::item {
    border: none;
}
QListView#messageListView QScrollBar:vertical {
    width: 7px;
    margin: 5px 2px 5px 0;
    background: transparent;
}
QListView#messageListView QScrollBar::handle:vertical {
    min-height: 24px;
    border-radius: 3px;
    background: rgba(106, 83, 246, 0.20);
}
QListView#messageListView QScrollBar::add-line:vertical,
QListView#messageListView QScrollBar::sub-line:vertical {
    height: 0;
}
QListView#messageListView QScrollBar::add-page:vertical,
QListView#messageListView QScrollBar::sub-page:vertical {
    background: transparent;
}
